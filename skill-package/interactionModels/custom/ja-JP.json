{
  "interactionModel": {
    "languageModel": {
      "invocationName": "チャッピー",
      "intents": [
        {
          "name": "ChatIntent",
          "slots": [
            {
              "name": "query",
              "type": "AMAZON.SearchQuery"
            }
          ],
          "samples": [
            "{query}",
            "チャッピー {query}",
            "きいて {query}",
            "おしえて {query}",
            "しらべて {query}",
            "GPT {query}",
            "で {query}",
            "を使って {query}",
            "について教えて {query}",
            "を調べて {query}",
            "を解決して {query}"
          ]
        },
        {
          "name": "AMAZON.FallbackIntent",
          "samples": []
        },
        {
          "name": "AMAZON.StopIntent",
          "samples": ["おわり", "おわって", "とめて", "バイバイ"]
        },
        {
          "name": "AMAZON.CancelIntent",
          "samples": ["キャンセル", "やめて"]
        },
        {
          "name": "AMAZON.HelpIntent",
          "samples": ["つかいかた", "ヘルプ", "なにができるの"]
        }
      ],
      "types": []
    }
  }
}
