{
  "askToolkitVersion": "2.0.0",
  "profiles": {
    "stg": {
      "skillMetadata": {
        "src": "./skill-package"
      },
      "code": {
        "default": {
          "src": "./lambda",
          "buildFlow": "npm-build"
        }
      },
      "skillInfrastructure": {
        "type": "@ask-cli/lambda-deployer",
        "userConfig": {
          "runtime": "nodejs22.x",
          "handler": "index.handler",
          "templateType": "cfn",
          "awsRegion": "ap-northeast-1",
          "timeout": 30
        }
      }
    }
  }
}